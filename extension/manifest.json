{
  "manifest_version": 3,
  "name": "PhishGuard AI — Real-Time Phishing Protection",
  "version": "1.0.0",
  "description": "Automatic real-time phishing detection and navigation protection powered by PhishGuard AI.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PhishGuard AI Protection Status",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "webNavigation",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "warning/warning.html",
        "warning/warning.css",
        "warning/warning.js",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
