# PhishGuard AI - Production Backend Dockerfile
FROM python:3.10-slim

WORKDIR /app

# Install system dependencies (build-essential, libzbar for QR decoding, tesseract-ocr)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libzbar0 \
    tesseract-ocr \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

COPY . .

# Set non-root security user
RUN useradd -m -u 1000 phishguard && chown -R phishguard:phishguard /app
USER phishguard

ENV PORT=8000 \
    PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
