# PhishGuard AI Environment Configuration Example

# Database (Default: SQLite; or postgresql+asyncpg://user:pass@localhost:5432/phishguard)
DATABASE_URL=sqlite+aiosqlite:///./phishguard.db

# Security & JWT
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_NAME=phishguard_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Threat Intelligence API Keys (Optional)
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_KEY=

# SMTP Email Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@phishguard.ai

# Rate Limiting
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_SCAN=30/minute
RATE_LIMIT_FORGOT_PASSWORD=3/minute

# Upload & Batch Limits
MAX_UPLOAD_SIZE_MB=10
MAX_BATCH_URLS=100
