# =================================================================
# PhishGuard AI - Environment Variables Configuration Template
# =================================================================

# Core Application Settings
ENVIRONMENT=development
PROJECT_NAME="PhishGuard AI"
VERSION="1.0.0"
DEBUG=true

# Database Configuration
# Local SQLite Default (Zero-Setup):
DATABASE_URL=sqlite+aiosqlite:///./phishguard.db
# Production PostgreSQL (Render / Docker):
# DATABASE_URL=postgresql+asyncpg://phishguard:password@localhost:5432/phishguard

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_NAME=phishguard_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Allowed CORS Origins (JSON list format)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Threat Intelligence Provider API Keys (Optional - System handles missing keys gracefully)
# Get free key from: https://www.virustotal.com/
VIRUSTOTAL_API_KEY=
# Get key from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_SAFE_BROWSING_KEY=

# Email / SMTP Configuration for Password Recovery (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=security@phishguard.ai

# Platform Limits & Rate Limits
MAX_UPLOAD_SIZE_MB=10
MAX_BATCH_URLS=100
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_FORGOT_PASSWORD=3/minute
RATE_LIMIT_SCAN=30/minute
